# REMIP — environment template. Copy to .env and fill in. NEVER commit .env.

# Required: JWT signing secret (generate with: openssl rand -hex 32)
REMIP_SECRET_KEY=

# Postgres password used by docker-compose (dev default exists, set your own)
POSTGRES_PASSWORD=

# Optional overrides
# REMIP_DATABASE_URL=sqlite:///./remip.db
# REMIP_ENVIRONMENT=development
# REMIP_SEED_ON_STARTUP=true
# REMIP_DEMO_MODE=true

# Outbound email via Gmail (M6, see docs/DEPLOYMENT.md §9 for how to get an
# App Password). Leave REMIP_SMTP_HOST unset to keep the console/log
# adapter (no real email sent) — the default in remip/backend.
# REMIP_SMTP_HOST=smtp.gmail.com
# REMIP_SMTP_PORT=587
# REMIP_SMTP_USER=your-address@gmail.com
# REMIP_SMTP_PASSWORD=            # the 16-character App Password, not your normal password
# REMIP_SMTP_FROM=your-address@gmail.com

# Google OAuth login (M6, see docs/DEPLOYMENT.md §9 for how to create
# these in Google Cloud Console). Leave both unset to keep OAuth login
# disabled (GET /auth/oauth/providers returns an empty list).
# REMIP_OAUTH_GOOGLE_CLIENT_ID=
# REMIP_OAUTH_GOOGLE_CLIENT_SECRET=
# REMIP_OAUTH_REDIRECT_BASE_URL=http://localhost:3000
