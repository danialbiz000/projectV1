# REMIP — environment template. Copy to .env and fill in. NEVER commit .env.

# Required: JWT signing secret (generate with: openssl rand -hex 32)
REMIP_SECRET_KEY=

# Postgres password used by docker-compose (dev default exists, set your own)
POSTGRES_PASSWORD=

# Optional overrides
# REMIP_DATABASE_URL=sqlite:///./remip.db
# REMIP_ENVIRONMENT=development
# REMIP_SEED_ON_STARTUP=true
# REMIP_DEMO_MODE=true
