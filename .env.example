# ─── Alpaca Markets ───────────────────────────────────────────────────────────
ALPACA_API_KEY=your_alpaca_key_id
ALPACA_SECRET_KEY=your_alpaca_secret_key
ALPACA_BASE_URL=https://paper-api.alpaca.markets
ALPACA_DATA_URL=https://data.alpaca.markets
# Per live trading: ALPACA_BASE_URL=https://api.alpaca.markets

# ─── Anthropic ────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=your_anthropic_api_key

# ─── Nexus Security ───────────────────────────────────────────────────────────
# OBBLIGATORIO in produzione — usa un valore random lungo almeno 32 caratteri
NEXUS_ADMIN_TOKEN=change_me_to_a_strong_random_secret

# ─── Nexus Configuration ──────────────────────────────────────────────────────
NEXUS_DATA_DIR=/data
NEXUS_SESSION_HOURS=12
# URL della tua istanza cloud + localhost per sviluppo
NEXUS_ALLOWED_ORIGINS=https://your-domain.com,http://localhost:3000
NEXUS_MAX_ORDER_NOTIONAL=5000
NEXUS_MAX_ORDER_QTY=1000
NEXUS_AUTOTRADER_MAX_DAILY_TRADES=8
# NEXUS_ENABLE_LIVE_TRADING=true  # Decommentare SOLO per live trading reale

# ─── Telegram Notifications ───────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=production
